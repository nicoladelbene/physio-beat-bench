#!/bin/bash
# The 2014 template calls NAME('REC',0) on one-argument functions, which old Octave tolerated and
# modern Octave rejects. Route the call through a shim; entry source is untouched.
args=()
for a in "$@"; do
  args+=("$(printf '%s' "$a" | /usr/bin/perl -pe "s/\b(\w+)\('([^']+)',\s*0\)/physio_beat_bench_call('\$1','\$2',0)/")")
done
case "$(uname -s)" in Darwin) real=/opt/homebrew/bin/octave ;; *) real=/usr/bin/octave ;; esac
exec "$real" --no-gui --no-window-system "${args[@]}"
